# ==============================================================================
# Crabdeck Quantum Omni-Layer — Environment Variables Specification
# ==============================================================================

# --- SERVER-SIDE SECRETS (Do not expose to browser / no VITE_ prefix) ---
# GEMINI_API_KEY: Required for server-side Gemini 3.8 Flash proxy (/api/gemini/chat).
# Injected automatically in AI Studio or configured in deployment secret manager.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Server listening port (defaults to 3000)
PORT=3000

# --- CLIENT-SIDE PARAMETERS (Prefixed with VITE_) ---
# APP_URL: Canonical public URL where the application is accessible
VITE_APP_URL="https://hermesclaw.ai"
VITE_API_BASE_URL="https://hermesclaw.ai/api"

# Firebase & Google Workspace OAuth Client Parameters (Public Identifiers)
VITE_FIREBASE_PROJECT_ID="second-broker-412618"
VITE_FIREBASE_APP_ID="1:70954141715:web:ac366beba3e5e4d1c957e6"
