import hashlib, json, time


def compute_approval_nonce(tool_name: str, tool_args: dict, salt: str = "claw_sovereign") -> str:


    payload = json.dumps({"tool": tool_name, "args": tool_args, "salt": salt}, sort_keys=True)


    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]


def verify_approval_nonce(nonce: str, tool_name: str, tool_args: dict, salt: str = "claw_sovereign") -> bool:


    return nonce == compute_approval_nonce(tool_name, tool_args, salt)


