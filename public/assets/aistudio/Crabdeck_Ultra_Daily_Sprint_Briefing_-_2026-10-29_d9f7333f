def handle_mcp_message(line: str) -> str:


    try:


        msg = json.loads(line)


        method = msg.get("method")


        msg_id = msg.get("id")


        if method == "tools/list":


            return json.dumps({"jsonrpc": "2.0", "id": msg_id, "result": {"tools": [{"name": "crm_get_contact", "description": "Fetch CRM contact"}]}})


        return json.dumps({"jsonrpc": "2.0", "id": msg_id, "error": {"code": -32601, "message": "Method not found"}})


    except Exception as e:


        return json.dumps({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": str(e)}})


