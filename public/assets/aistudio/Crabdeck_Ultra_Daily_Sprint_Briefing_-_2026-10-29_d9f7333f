* Task 2.1: Implement platform abstraction layer for process sandboxing:import os, sys, subprocess


def run_sandboxed(cmd: list[str], max_memory_mb: int = 512, timeout_sec: int = 30):


    if sys.platform == "win32":


        # Win32 Job Object confinement (chase2x2)


        import win32job, win32process


        job = win32job.CreateJobObject(None, "")


        info = win32job.QueryInformationJobObject(job, win32job.JobObjectExtendedLimitInformation)


        info['BasicLimitInformation']['LimitFlags'] = win32job.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE


        info['ProcessMemoryLimit'] = max_memory_mb * 1024 * 1024


        win32job.SetInformationJobObject(job, win32job.JobObjectExtendedLimitInformation, info)


    else:


        # POSIX rlimits for Linux / Termux


        import resource


        def preexec():


            resource.setrlimit(resource.RLIMIT_AS, (max_memory_mb * 1024 * 1024, max_memory_mb * 1024 * 1024))


    return subprocess.run(cmd, capture_output=True, timeout=timeout_sec)


