# install-crabdeck.ps1 — Crabdeck Host Workstation Automated Installer


[CmdletBinding()]


param (


    [switch]$NoDocker,


    [switch]$SkipMobile


)


$ErrorActionPreference = "Stop"


Set-ExecutionPolicy -Scope Process RemoteSigned -Force


Write-Host "==> Initializing Crabdeck Quantum Host Setup Strategy..." -ForegroundColor Cyan


function Assert-Dependency ($command, $name) {


    if (-not (Get-Command $command -ErrorAction SilentlyContinue)) {


        Write-Error "Missing required dependency: $name. Please install it before proceeding."


        exit 1


    }


}


Assert-Dependency "node" "Node.js v20+"


Assert-Dependency "python" "Python 3.11+"


Assert-Dependency "git" "Git SCM"


if ($NoDocker) {


    Write-Host "[CONFIG] Executing under --no-docker strategy. Binding to local loopback 127.0.0.1..." -ForegroundColor Yellow


    $env:CRABDECK_NO_DOCKER = "1"


    $env:OLLAMA_HOST = "127.0.0.1:11434"


}


Write-Host "==> Installing Node dependencies..." -ForegroundColor Green


npm install


Write-Host "==> Compiling Web Distribution Asset (dist/)..." -ForegroundColor Green


npm run build


if (-not $SkipMobile) {


    Write-Host "==> Syncing Capacitor Native Android Platform..." -ForegroundColor Green


    npx cap sync android


}


Write-Host "==> Host Setup Completed Successfully." -ForegroundColor Cyan
